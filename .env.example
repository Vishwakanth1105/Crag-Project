GEMINI_API_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentic_graph_rag

# Application database (MySQL 8.4 via Docker, host port remapped to 3307
# because a local mysqld occupies 3306). Inside Docker Compose this is
# overridden by DATABASE_URL_DOCKER in docker-compose.yml.
DATABASE_URL=mysql+pymysql://rag:rag_password@localhost:3307/rag?charset=utf8mb4

# MinIO object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-secret
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-secret
MINIO_BUCKET=documents

# Auth / sessions / CSRF
SESSION_SECRET=generate-with-python-secrets-token-hex-32
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# CORS: comma-separated allowed origins. Leave empty for same-origin only
# (the default: Vite dev proxy and nginx both serve the UI from the API's origin).
# Example if you host the UI elsewhere: CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=

# Transactional email via Brevo (https://brevo.com, free tier: 300 emails/day).
# Needed for password-reset emails. While BREVO_API_KEY is empty, emails are
# logged to the api container output instead of being delivered.
BREVO_API_KEY=
# Must be a sender address verified in your Brevo account.
BREVO_FROM_EMAIL=

# Public base URL of the web UI; used to build password-reset links.
FRONTEND_URL=https://crag-project-two.vercel.app

# Upload limits (bytes)
UPLOAD_MAX_BYTES=20971520

# Web UI (served by the `frontend` service at http://localhost:8080)

# LLM provider: `local` runs fully offline via Ollama + sentence-transformers
# (no API keys, no quota, no cost). `gemini` uses Google AI instead.
LLM_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
# ~1.7 GB RAM; switch to qwen2.5:3b if you have more memory headroom.
OLLAMA_MODEL=gemma2:2b
# 768 dims - matches EMBEDDING_DIMENSIONS so the Qdrant collection is shared.
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LOCAL_REQUEST_TIMEOUT_SECONDS=240

EMBEDDING_MODEL=models/gemini-embedding-001
GENERATION_MODEL=gemini-3.6-flash
EVALUATION_MODEL=gemini-3.5-flash-lite
RERANK_MODEL=rerank-english-v3.0

PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=500
CHILD_CHUNK_OVERLAP=75

VECTOR_TOP_K=12
GRAPH_TOP_K=12
RERANK_TOP_K=5
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
MIN_RELEVANT_DOCUMENTS=2
MIN_AVERAGE_RELEVANCE=0.55
MIN_TRIPLE_CONFIDENCE=0.5
